# Copy to .env and change the secrets before deploying
PORT=4000
NODE_ENV=development
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret-string
# Origin of the React client (used for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173
# Seeded admin account (change these!)
ADMIN_EMAIL=admin@scentrances.com
ADMIN_PASSWORD=Admin@12345
